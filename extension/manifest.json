{
  "manifest_version": 3,
  "name": "AuraGaze",
  "version": "1.0.0",
  "description": "A sensory-safe way to read the web.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AuraGaze Sensory Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["profile.js", "load-score.js", "Readability.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
